{
  "$comment": "ath-hud hooks block for Claude Code — blueprint of what agents/claude/install.mjs writes. Replace both occurrences of the placeholder path with the deployed hook (~/.ath/claude/hook.mjs; forward slashes are fine). Merge-style: only entries pointing at that path belong to ath-hud, foreign hooks stay untouched.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<deploy-path>/ath/claude/hook.mjs"] } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<deploy-path>/ath/claude/hook.mjs"] } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<deploy-path>/ath/claude/hook.mjs"] } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<deploy-path>/ath/claude/hook.mjs"] } ] }
    ],
    "PostToolUseFailure": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<deploy-path>/ath/claude/hook.mjs"] } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<deploy-path>/ath/claude/hook.mjs"] } ] }
    ],
    "PermissionDenied": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<deploy-path>/ath/claude/hook.mjs"] } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<deploy-path>/ath/claude/hook.mjs"] } ] }
    ],
    "StopFailure": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<deploy-path>/ath/claude/hook.mjs"] } ] }
    ],
    "Notification": [
      { "matcher": "idle_prompt", "hooks": [ { "type": "command", "command": "node", "args": ["<deploy-path>/ath/claude/hook.mjs"] } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<deploy-path>/ath/claude/hook.mjs"], "timeout": 10 } ] }
    ]
  }
}
