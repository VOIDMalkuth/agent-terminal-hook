{
  "$comment": "ath-hud hooks block for Claude Code. Merge the `hooks` key into ~/.claude/settings.json (user scope) and replace both occurrences of the placeholder path with the absolute path of agents/claude/hook.mjs (forward slashes are fine). agent-hook generates this automatically via agents/claude/install.mjs (phase 2).",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<abs-path>/agents/claude/hook.mjs"] } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<abs-path>/agents/claude/hook.mjs"] } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<abs-path>/agents/claude/hook.mjs"] } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<abs-path>/agents/claude/hook.mjs"] } ] }
    ],
    "PostToolUseFailure": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<abs-path>/agents/claude/hook.mjs"] } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<abs-path>/agents/claude/hook.mjs"] } ] }
    ],
    "PermissionDenied": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<abs-path>/agents/claude/hook.mjs"] } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<abs-path>/agents/claude/hook.mjs"] } ] }
    ],
    "StopFailure": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<abs-path>/agents/claude/hook.mjs"] } ] }
    ],
    "Notification": [
      { "matcher": "idle_prompt", "hooks": [ { "type": "command", "command": "node", "args": ["<abs-path>/agents/claude/hook.mjs"] } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["<abs-path>/agents/claude/hook.mjs"], "timeout": 10 } ] }
    ]
  }
}
